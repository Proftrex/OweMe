   ========================================================= */

async function loadPaymentProviders() {

  const result =
    await api(
      "getPaymentProviders",
      {},
      "GET"
    );

  return result.providers || [];
}


async function loadPaymentDetails() {

  const result =
    await api(
      "getPaymentDetails",
      {},
      "GET"
    );

  return result.paymentDetails || [];
}


async function renderProfile() {

  $("#pageTitle").textContent = "Profile";

  $("#content").innerHTML = `

    <div class="card">

      <div class="card-title">
